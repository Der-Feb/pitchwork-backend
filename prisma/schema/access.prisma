enum ENGender {
  MALE
  FEMALE
}

model Person {
  id             String   @id @default(cuid())
  firstName      String   @map("first_name") @db.VarChar(100)
  lastName       String   @map("last_name") @db.VarChar(100)
  gender         ENGender
  dob            DateTime @db.Date
  nationality    String
  profilePicture String?  @map("profile_picture")

  // timestamps
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user User?
  memberships Membership[]
  athleteRelations   PersonRelation[] @relation("AthleteRelations")
  relatedPersonLinks PersonRelation[] @relation("RelatedPersonLinks")

  @@map("persons")
}

enum ENIdentifierType {
  EMAIL
  PHONE
  GOOGLE
  APPLE
}

model User {
  id              String  @id @default(cuid())
  passwordHash    String? @map("password_hash")
  twoFactorSecret String? @map("two_factor_secret")

  // boolean
  isEmailVerified    Boolean @default(false) @map("is_email_verified")
  isDeleted          Boolean @default(false) @map("is_deleted")
  isTwoFactorEnabled Boolean @default(false) @map("is_two_factor_enabled")

  // timestamps
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  lastLogin DateTime? @map("last_login") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  // relations
  personId String @unique @map("person_id")
  person   Person @relation(fields: [personId], references: [id])
  tokens UserToken[]

  @@map("users")
}

model UserIdentifier {
  id     String           @id @default(cuid())
  userId String           @map("user_id")
  type   ENIdentifierType
  value  String

  // boolean
  isPrimary Boolean @default(false) @map("is_primary")

  // timestamps
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([type, value])
  @@map("user_identifiers")
}

enum ENUserTokenType {
  EMAIL_VERIFICATION
  CHANGE_PASSWORD
  LOGIN_OTP // Optional addition if you use OTP login
}

enum ENUserTokenStatus {
  PENDING
  DISRUPTED
}

model UserToken {
  id     String            @id @default(cuid())
  type   ENUserTokenType
  hash   String            @unique
  status ENUserTokenStatus @default(PENDING)

  // relations
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  // timestamps
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("user_tokens")
}

enum ENInvitationStatus {
  PENDING
  DISRUPTED
}

model Invitation {
  id             String             @id @default(cuid())
  email          String?            @map("email")
  phone          String?            @map("phone")
  tokenHash      String             @map("token_hash")
  failedAttempts Int                @default(0) @map("failed_attempts")
  type           ENMembershipType
  status         ENInvitationStatus @default(PENDING)
  teamId         String?            @map("team_id")

  // relations
  inviterId String     @map("inviter_id")
  inviter   Membership @relation("MembershipSentInvitations", fields: [inviterId], references: [id])

  // timestamps
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(3)

  @@index([email, phone])
  @@index([email, tokenHash, status])
  @@index([expiresAt])
  @@map("invitations")
}
